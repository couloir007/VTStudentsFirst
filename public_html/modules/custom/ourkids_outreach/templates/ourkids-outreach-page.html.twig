{#
/**
 * @file
 * Legislator outreach admin page.
 */
#}

<div class="ourkids-outreach">

  <div class="ourkids-outreach__intro">
    <p>Preview and send a tracked email to each legislator. Each email contains a unique tracking link. Progress is saved in your browser.</p>
    <p class="ourkids-outreach__counts">
      <strong id="outreach-sent-count">0</strong> sent &nbsp;·&nbsp;
      <strong>{{ representatives|length + senators|length }}</strong> total
    </p>
    <button class="ourkids-outreach__reset" id="outreach-reset" type="button">Reset progress</button>
  </div>

  <div class="ourkids-outreach__tabs">
    <button class="ourkids-outreach__tab is-active" data-tab="house" type="button">
      House <span class="ourkids-outreach__tab-count">({{ representatives|length }})</span>
    </button>
    <button class="ourkids-outreach__tab" data-tab="senate" type="button">
      Senate <span class="ourkids-outreach__tab-count">({{ senators|length }})</span>
    </button>
  </div>

  <div class="ourkids-outreach__panel is-active" id="outreach-panel-house">
    <table class="ourkids-outreach__table">
      <thead>
        <tr>
          <th>Name</th>
          <th>District</th>
          <th>Email</th>
          <th>Ref</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {% for leg in representatives %}
          <tr class="ourkids-outreach__row" data-ref="{{ leg.ref }}">
            <td><strong>{{ leg.name }}</strong></td>
            <td>{{ leg.district }}</td>
            <td><a href="mailto:{{ leg.email }}">{{ leg.email }}</a></td>
            <td><code>{{ leg.ref }}</code></td>
            <td>
              <button class="ourkids-outreach__preview-btn" data-ref="{{ leg.ref }}" type="button">Preview &amp; Send</button>
              <span class="ourkids-outreach__sent-badge" hidden>✓ Sent</span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="ourkids-outreach__panel" id="outreach-panel-senate">
    <table class="ourkids-outreach__table">
      <thead>
        <tr>
          <th>Name</th>
          <th>District</th>
          <th>Email</th>
          <th>Ref</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {% for leg in senators %}
          <tr class="ourkids-outreach__row" data-ref="{{ leg.ref }}">
            <td><strong>{{ leg.name }}</strong></td>
            <td>{{ leg.district }}</td>
            <td><a href="mailto:{{ leg.email }}">{{ leg.email }}</a></td>
            <td><code>{{ leg.ref }}</code></td>
            <td>
              <button class="ourkids-outreach__preview-btn" data-ref="{{ leg.ref }}" type="button">Preview &amp; Send</button>
              <span class="ourkids-outreach__sent-badge" hidden>✓ Sent</span>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>

{# ── Preview modal ───────────────────────────────────────────────────────── #}
<div class="ourkids-modal" id="outreach-modal" hidden>
  <div class="ourkids-modal__backdrop"></div>
  <div class="ourkids-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="outreach-modal-title">
    <div class="ourkids-modal__header">
      <h2 class="ourkids-modal__title" id="outreach-modal-title">Preview Email</h2>
      <button class="ourkids-modal__close" id="outreach-modal-close" type="button" aria-label="Close">✕</button>
    </div>
    <div class="ourkids-modal__meta">
      <p><strong>To:</strong> <span id="modal-to"></span></p>
      <p><strong>Subject:</strong> <span id="modal-subject"></span></p>
    </div>
    <div class="ourkids-modal__body">
      <iframe id="modal-preview" title="Email preview" frameborder="0"></iframe>
    </div>
    <div class="ourkids-modal__footer">
      <button class="ourkids-outreach__send-btn" id="outreach-send-btn" type="button">Send Email</button>
      <button class="ourkids-modal__cancel" id="outreach-modal-cancel" type="button">Cancel</button>
      <span class="ourkids-outreach__sending" id="outreach-sending" hidden>Sending…</span>
      <span class="ourkids-outreach__send-success" id="outreach-send-success" hidden>✓ Sent successfully</span>
      <span class="ourkids-outreach__send-error" id="outreach-send-error" hidden></span>
    </div>
  </div>
</div>

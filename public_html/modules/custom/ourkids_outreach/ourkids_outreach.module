<?php

/**
 * @file
 * OurKids Legislator Outreach module.
 */

/**
 * Implements hook_theme().
 */
function ourkids_outreach_theme(): array {
  return [
    'ourkids_outreach_page' => [
      'variables' => [
        'representatives' => [],
        'senators'        => [],
      ],
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function ourkids_outreach_mail(string $key, array &$message, array $params): void {
  if ($key !== 'legislator_outreach') {
    return;
  }

  $message['subject']                    = $params['subject'];
  $message['body'][]                     = $params['body'];
  $message['headers']['Content-Type']    = 'text/html; charset=UTF-8';
  $message['headers']['From']            = $params['headers']['From'];
  $message['headers']['Reply-To']        = $params['headers']['Reply-To'];
  $message['headers']['MIME-Version']    = '1.0';
}

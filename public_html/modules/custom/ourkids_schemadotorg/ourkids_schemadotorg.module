<?php

/**
 * @file
 * Primary module hooks for OurKidsOurSchoolsVT Schema.org module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;
use Drupal\ourkids_schemadotorg\JsonLd\PersonJsonLd;
use Drupal\ourkids_schemadotorg\JsonLd\ArticleJsonLd;
use Drupal\ourkids_schemadotorg\JsonLd\ProfilePageJsonLd;
use Drupal\ourkids_schemadotorg\JsonLd\TuitioningTownsPageJsonLd;

/**
 * Implements hook_schemadotorg_jsonld_alter().
 *
 * At this point schemadotorg_additional_mappings has already run and wrapped
 * the entity in a WebPage:
 *
 *   $data['schemadotorg_jsonld_entity'] = WebPage + ['mainEntity' => Article]
 */
function ourkids_schemadotorg_schemadotorg_jsonld_alter(array &$data, RouteMatchInterface $route_match, BubbleableMetadata $bubbleable_metadata): void {
  $node = $route_match->getParameter('node');
  if (!($node instanceof NodeInterface)) {
    return;
  }

  $entity = &$data['schemadotorg_jsonld_entity'];

  // Tuitioning towns listing page — inject ItemList mainEntity.
  TuitioningTownsPageJsonLd::alter($data, $node, $bubbleable_metadata);

  if ($node->bundle() === 'article') {
    // articleBody should be plain text, not rendered HTML.
    // Replace it with a clean version from body.processed.
    $articleBody = $data['schemadotorg_jsonld_entity']['articleBody'];
    $data['schemadotorg_jsonld_entity']['articleBody'] = trim(strip_tags($articleBody));

    // Description Clean
    $description = preg_replace('/<\/p>\s*<p[^>]*>/i', "\n\n", $data['schemadotorg_jsonld_entity']['description']);
    $data['schemadotorg_jsonld_entity']['description'] = trim(strip_tags($description));

    return;
  }
}

/**
 * Implements hook_schemadotorg_jsonld_schema_type_entity_alter().
 */
function ourkids_schemadotorg_schemadotorg_jsonld_schema_type_entity_alter(array &$data, EntityInterface $entity, mixed $mapping, BubbleableMetadata $bubbleable_metadata): void {
  if (!($entity instanceof NodeInterface)) {
    return;
  }

  match ($data['@type'] ?? NULL) {
    'Person'      => PersonJsonLd::alter($data, $entity, $bubbleable_metadata),
    'ProfilePage' => ProfilePageJsonLd::alter($data, $entity, $bubbleable_metadata),
    default       => NULL,
  };
}

{{ attach_library('surface/node') }}

{% set classes = [
  'node',
  attributes ? attributes.class
]|join(' ')|trim %}

{% set title_classes = [
  'node__title',
  title_attributes ? title_attributes.class
]|join(' ')|trim %}

{% set content_classes = [
  'node__content',
  content_attributes ? content_attributes.class
]|join(' ')|trim %}

<article class="{{ classes }}" {{ attributes ? attributes|without('class', 'id') }}>
  <div class="{{ content_classes }}" {{ content_attributes ? content_attributes|without('class') }}>
    <div class="node__inner">
      {% if content.schema_citation %}
        <div class="prose">
            <span class="issue-section__lead">
              <p>{{ content.schema_citation|field_value }}</p>
            </span>
        </div>
      {% endif %}

      {{ content.body }}
    </div>
  </div>
</article>

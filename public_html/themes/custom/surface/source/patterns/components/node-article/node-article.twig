{{ attach_library('surface/node-article') }}

{% set classes = [
  'node',
  attributes ? attributes.class
]|join(' ')|trim %}

<article class="{{ classes }}" {{ attributes ? attributes|without('class', 'id') }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% include '@components/node-article-body/node-article-body.twig' with {
    date:       content.schema_date_published|field_value,
    read_time:  content.field_read_time|field_value,
    lead:       content.schema_citation|field_value,
    body:       content.body|field_value,
  } only %}

</article>

{#
/**
 * @file tuitioning-towns-section.twig
 *
 * Component:  @collections/tuitioning-towns-section/tuitioning-towns-section.twig
 * Storybook:  Collections/Tuitioning Towns Section
 *
 * Variables:
 *   section_label  (string) — optional eyebrow label
 *   headline       (string) — optional section headline
 *   body_text      (string) — optional intro prose (trusted HTML)
 *   towns_view     (string) — rendered view markup (passed from Drupal template)
 *                             In Storybook, pass a stub list instead.
 */
#}

{{ attach_library('surface/tuitioning-towns-section') }}
{{ attach_library('surface/page-title') }}

{% embed "@layouts/section/section.twig" with {
  section_class: 'tuitioning-towns-section section-theme--light',
  inner_class: 'tuitioning-towns-section__inner',
  id: id,
  attributes: attributes,
  modifier: modifier
} %}
  {% block content %}

    <h1 class="page-title section-headline section-headline--black tuitioning-towns-section__headline">
      <span>Vermont Tuitioning Towns: Complete List by District</span>
    </h1>

    {% if headline %}
      {% include "@elements/section-headline/section-headline.twig" with {
        text: headline,
        modifier: 'black',
        class: 'tuitioning-towns-section__headline'
      } only %}
    {% endif %}

    {% if body_text %}
      <div class="tuitioning-towns-section__intro">
        {{ body_text|raw }}
      </div>
    {% endif %}

    {% if towns_view %}
      <div class="tuitioning-towns-section__list">
        {{ towns_view|raw }}
      </div>
    {% endif %}

  {% endblock %}
{% endembed %}

{#
/**
 * @file
 * Surface theme override for the footer region.
 *
 * Embeds site-footer.twig and overrides the branding and menu blocks
 * with real Drupal content.
 *
 * Drupal menu setup:
 *   Create two menus in Structure → Menus:
 *   - Machine name: footer-navigate  → Navigate column
 *   - Machine name: footer-involved  → Get Involved column
 */
#}


  {% embed '@layouts/site-footer/site-footer.twig' with {
    'site_extra': site_extra is not empty ? site_extra : false,
  } %}

    {% block branding %}
      <h3 class="site-footer__logo">Our<span>Kids</span>Our<span>Schools</span>VT</h3>
      <p class="site-footer__desc">A coalition of Vermont parents, educators, employers,
        and community members committed to protecting equitable education access
        for rural students.</p>
    {% endblock %}
  {% endembed %}


{% set classes = [
  'node--type-' ~ node.bundle|clean_class,
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class
]%}

{% set attributes = attributes.addClass(classes) %}

{% set month = node.schema_event_schedule.value ? node.schema_event_schedule.value|date('M') : '' %}
{% set day = node.schema_event_schedule.value ? node.schema_event_schedule.value|date('j') : '' %}

{% include '@components/node/node-event.twig' with {
  'attributes': attributes,
  'title_prefix': title_prefix,
  'title_suffix': title_suffix,
  'label': label,
  'page': page,
  'image': image,
  'url': url,
  'month': month,
  'day': day,
  'content': content|without('field_image', 'links')
} %}

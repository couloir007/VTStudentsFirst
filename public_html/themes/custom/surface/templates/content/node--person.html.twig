{#
/**
 * @file node--person.html.twig
 *
 * Drupal template for Person nodes — full page view mode.
 * Maps Drupal fields → @components/node-person/node-person.twig
 */
#}

{% set classes = [
  'node--type-' ~ node.bundle|clean_class,
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
] %}

{% set attributes = attributes.addClass(classes) %}

{% set schools = [] %}
{% for s in node.field_school_connection %}
  {% set schools = schools|merge([s.value]) %}
{% endfor %}

{% set articles = [] %}
{% for item in node.field_contributions %}
  {% set para = item.entity %}
  {% if para %}
    {% set articles = articles|merge([{
      title:    para.schema_url.title,
      url:      para.schema_url.uri,
      topic:    para.field_topic.value,
      date:     para.schema_date_published.value ? para.schema_date_published.value|date('F j, Y') : null,
      date_iso: para.schema_date_published.value ? para.schema_date_published.value|date('Y-m-d') : null,
    }]) %}
  {% endif %}
{% endfor %}

{% include '@components/node-person/node-person.twig' with {
  attributes: attributes,
  name:       label,
  job_title:  node.schema_job_title.value,
  town:       node.schema_address.locality,
  school:     schools,
  quote:      node.field_quote.value,
  image:      content.schema_image,
  bio:        content.body|field_value,
  articles:   articles,
} only %}

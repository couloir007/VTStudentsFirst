{#
/**
 * @file node--person.html.twig
 *
 * Drupal template for Person nodes (full page view mode).
 * Maps Drupal fields → @components/node-person/node-person.twig
 *
 * Fields:
 *   schema_name            → name (from label)
 *   schema_job_title       → job_title
 *   schema_address         → town (locality)
 *   field_school_connection → school
 *   field_quote            → quote
 *   schema_image           → image
 *   body                   → bio
 *   field_articles         → articles (entity ref to Article nodes)
 */
#}

{% set classes = [
  'node--type-' ~ node.bundle|clean_class,
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
] %}

{% set attributes = attributes.addClass(classes) %}

{% set articles = [] %}
{% for item in node.field_articles %}
  {% set article = item.entity %}
  {% if article %}
    {% set articles = articles|merge([{
      title:    article.label,
      url:      path('entity.node.canonical', {'node': article.id()}),
      date:     article.schema_date_published.value|date('F j, Y'),
      date_iso: article.schema_date_published.value|date('Y-m-d'),
      topic:    article.field_topic.value,
    }]) %}
  {% endif %}
{% endfor %}

{% include '@components/node-person/node-person.twig' with {
  attributes:  attributes,
  name:        label,
  job_title:   node.schema_job_title.value,
  town:        node.schema_address.locality,
  school:      node.field_school_connection.value,
  quote:       node.field_quote.value,
  image:       content.schema_image,
  bio:         node.body.processed,
  articles:    articles,
} only %}

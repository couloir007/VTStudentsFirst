{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class
]%}

{% set attributes = attributes.addClass(classes) %}

<article {{ attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <div class="node__content">
    <div class="node__inner">

      {# schema_main_entity — primary paragraph sections #}
      {% for idx, item in content.schema_main_entity %}
        {% if item['#paragraph'] is defined %}
          {{ item }}
        {% endif %}
      {% endfor %}

      {# field_sections — supplementary paragraph sections #}
      {% for idx, item in content.field_sections %}
        {% if item['#paragraph'] is defined %}
          {{ item }}
        {% endif %}
      {% endfor %}

    </div>
  </div>
</article>
